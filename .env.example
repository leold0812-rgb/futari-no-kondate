# 値は空のまま。実値は .env.local（Git管理外）またはVercelの環境変数へ設定する。
# Development と Production で別のSupabase / Vercel / OpenAI / Blob を使うこと。

# ブラウザへ公開される値（anon keyのみ）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用。NEXT_PUBLIC_ を付けない・Client Componentから参照しない
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
